# Third-party manufacturer PDFs: linked in README.md instead of redistributed
*.pdf
# keep my own generated summary
!FPGAFlow/portfolio/summary.pdf

# Vivado generated
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.jou
*.str
vivado*.backup*
webtalk*
xsim.dir/
*.wdb
*.pb

# Vivado runs: ignore everything except the bitstreams and utilization reports cited in GUIDE.md
*.runs/**
!*.runs/**/
!*.runs/impl_1/*.bit
!*.runs/impl_1/*_utilization_placed.rpt

# Logs: ignore Vivado/xsim logs, keep the result logs cited as evidence
*.log
!FPGAFlow/results/*.log

# Windows Explorer metadata
desktop.ini
Thumbs.db

# Python
__pycache__/
*.pyc

# Large regenerable data (keep .stim circuits, baseline_d3_r3.json and gen_data.py)
FPGAFlow/data/10m/
FPGAFlow/data/*.npz
